<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.1.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.cloudpool</groupId>
    <artifactId>cloudpool-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>CloudPool Parent</name>
    <description>Decentralized BaaS Platform - Parent POM</description>

    <profiles>
        <profile>
            <id>student</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>cloudpool-common</module>
                <module>cloudpool-gateway</module>
                <module>cloudpool-auth</module>
                <module>cloudpool-data</module>
                <module>cloudpool-compute</module>
                <module>cloudpool-network</module>
            </modules>
            <properties>
                <cloudpool.profile>student</cloudpool.profile>
            </properties>
        </profile>
        <profile>
            <id>enterprise</id>
            <modules>
                <module>cloudpool-common</module>
                <module>cloudpool-gateway</module>
                <module>cloudpool-auth</module>
                <module>cloudpool-data</module>
                <module>cloudpool-compute</module>
                <module>cloudpool-network</module>
                <module>cloudpool-enterprise-plugin</module>
            </modules>
            <properties>
                <cloudpool.profile>enterprise</cloudpool.profile>
            </properties>
        </profile>
    </profiles>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2022.0.4</spring-cloud.version>
        <lombok.version>1.18.38</lombok.version>
        <opentelemetry.version>1.63.0</opentelemetry.version>
    </properties>

    <dependencyManagement>
        <dependencies>
        <!-- Event Driven Architecture (Macro/Micro) -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        <!-- OpenTelemetry BOM for distributed tracing -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0</version>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
