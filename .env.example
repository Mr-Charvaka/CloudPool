# CloudPool Configuration
# Copy this file to .env and fill in your values

# Database
POSTGRES_DB=cloudpool
POSTGRES_USER=cloudpool
POSTGRES_PASSWORD=change_me

# JWT
JWT_SECRET=generate_with_openssl_rand_base64_32
JWT_EXPIRATION_MS=3600000

# Encryption (must be identical across all services)
CLOUDPOOL_ENCRYPTION_MASTER_KEY=openssl_rand_base64_32
CLOUDPOOL_ENCRYPTION_SALT=openssl_rand_hex_16

# Google Drive OAuth
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret

# CORS
CLOUDPOOL_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
CLOUDPOOL_RATE_LIMIT_RPM=120

# Storage
CLOUDPOOL_STORAGE_COMPRESSION_ENABLED=false

# OpenAI / Weaviate
OPENAI_API_KEY=sk-your-key
WEAVIATE_API_KEY=your-weaviate-key

# AWS (optional, for S3 backups)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BACKUP_BUCKET=cloudpool-backups