# CloudPool Configuration
# Copy this file to .env for Docker Compose, or use --spring.profiles.active=local
# for standalone local dev (no Docker required).

# Database (only needed when NOT using local profile)
POSTGRES_DB=cloudpool
POSTGRES_USER=cloudpool
POSTGRES_PASSWORD=cloudpool

# JWT (defaults work for local dev — generate fresh for production)
JWT_SECRET=dev-jwt-secret-cloudpool-hs512-key-min-64-chars-must-be-long-enough!!
JWT_EXPIRATION_MS=3600000

# Encryption (defaults work for local dev — generate fresh for production)
CLOUDPOOL_ENCRYPTION_MASTER_KEY=dev-master-key-not-for-production-32bytes!
CLOUDPOOL_ENCRYPTION_SALT=dGVzdC1vbmx5LXNhbHQtdmFsdWUtMzItYnl0ZXMtbG9uZyEh

# Google Drive OAuth (optional — file operations fail gracefully without it)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# CORS
CLOUDPOOL_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
CLOUDPOOL_RATE_LIMIT_RPM=120

# Storage
CLOUDPOOL_STORAGE_COMPRESSION_ENABLED=false

# OpenAI / Weaviate (optional — vector search requires these)
OPENAI_API_KEY=
WEAVIATE_API_KEY=

# AWS (optional — S3 backups only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BACKUP_BUCKET=cloudpool-backups