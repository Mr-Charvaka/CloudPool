# CloudPool Environment Configuration
# Copy this file to .env and fill in the values for your environment
# Required for both local development and production deployment

# ================================================================================
# DATABASE & PERSISTENCE
# ================================================================================

# PostgreSQL connection (production)
# Format: jdbc:postgresql://host:port/database
# Leave empty to use H2 (local development fallback in MODE=PostgreSQL)
SPRING_DATASOURCE_URL=

# Database credentials (must have read/write permissions)
SPRING_DATASOURCE_USERNAME=cloudpool_user
SPRING_DATASOURCE_PASSWORD=

# ================================================================================
# ENCRYPTION & SECURITY
# ================================================================================

# Master key for AES-GCM envelope encryption (CRITICAL - generate with: openssl rand -base64 32)
# This protects:
#   - Project secrets (API keys, DB credentials)
#   - OAuth2 tokens
#   - Custom client secrets
# SECURITY: This value MUST be:
#   - Generated once and stored securely (e.g., HashiCorp Vault, AWS Secrets Manager)
#   - Identical across ALL four services (auth/network/data/compute)
#   - Rotated as per your security policy, with a migration script for existing data
# If lost/rotated, all encrypted data becomes inaccessible
CLOUDPOOL_ENCRYPTION_MASTER_KEY=

# Salt for HKDF key derivation in AES-GCM (CRITICAL - generate with: openssl rand -base64 32)
# This is used ALONGSIDE the master key to derive unique encryption keys per column
# SECURITY: This value MUST be:
#   - Generated once and stored securely
#   - Identical across ALL four services (they share one database)
#   - Never changed without re-encrypting all existing encrypted data
# IMPORTANT: Different salt per service = silently failed decryption of shared data
CLOUDPOOL_ENCRYPTION_SALT=

# JWT signing secret (used by all microservices for token validation)
# Generate with: openssl rand -base64 32
# SECURITY: Symmetric (HS512), shared across all services
JWT_SECRET=

# JWT expiration time in milliseconds (default 1 hour)
JWT_EXPIRATION_MS=3600000

# ================================================================================
# SERVICE CONFIGURATION
# ================================================================================

# Service discovery URLs (used by Spring Cloud Gateway for routing)
# Default to localhost for local development; set to internal IPs/DNS for production
CLOUDPOOL_SERVICES_AUTH_URL=http://localhost:8082
CLOUDPOOL_SERVICES_DATA_URL=http://localhost:8083
CLOUDPOOL_SERVICES_COMPUTE_URL=http://localhost:8084
CLOUDPOOL_SERVICES_NETWORK_URL=http://localhost:8085

# ================================================================================
# RATE LIMITING
# ================================================================================

# Rate limit (requests per minute) for all API endpoints
# Default: 120 requests/minute per user/API key
CLOUDPOOL_RATE_LIMIT_RPM=120

# ================================================================================
# STORAGE & FILES
# ================================================================================

# Max file upload size (default 5GB in bytes: 5368709120)
# This must match the gateway's max request body size
CLOUDPOOL_STORAGE_MAX_FILE_SIZE=5368709120

# ================================================================================
# VECTOR SEARCH (Weaviate)
# ================================================================================

# Weaviate vector database URL (for semantic/hybrid search)
# Local dev: http://localhost:8081
# Production: https://your-weaviate-cluster.example.com
WEAVIATE_URL=http://localhost:8081

# Weaviate API key (leave empty for local dev if auth disabled)
WEAVIATE_API_KEY=

# ================================================================================
# AI/ML EMBEDDINGS (OpenAI)
# ================================================================================

# OpenAI API key (for text embedding models)
# Required if using vector embeddings for semantic search
# Format: sk-...
OPENAI_API_KEY=

# ================================================================================
# EXTERNAL STORAGE PROVIDERS
# ================================================================================

# Google Drive Integration
# Generate OAuth2 credentials from: https://console.cloud.google.com
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8080/oauth/callback

# AWS S3 Integration (optional - configure in application YML if used)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=

# ================================================================================
# EMAIL & NOTIFICATIONS (Compute Service)
# ================================================================================

# SMTP configuration for transactional emails (job notifications, alerts)
CLOUDPOOL_EMAIL_SMTP_HOST=smtp.gmail.com
CLOUDPOOL_EMAIL_SMTP_PORT=587
CLOUDPOOL_EMAIL_SMTP_USER=noreply@yourcompany.com
CLOUDPOOL_EMAIL_SMTP_PASSWORD=
CLOUDPOOL_EMAIL_SMTP_FROM=noreply@yourcompany.com

# Enable sandbox mode (doesn't actually send emails, logs instead)
# Set to false in production
CLOUDPOOL_EMAIL_SANDBOX=true

# Embedded SMTP server (for local testing)
CLOUDPOOL_EMBEDDED_SMTP_ENABLED=true
CLOUDPOOL_EMBEDDED_SMTP_PORT=2525

# ================================================================================
# CORS CONFIGURATION
# ================================================================================

# Allowed origins for CORS requests (comma-separated)
# Local dev: http://localhost:3000,http://localhost:8080
# Production: https://your-frontend.example.com
CLOUDPOOL_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ================================================================================
# LOGGING & MONITORING
# ================================================================================

# Log level (TRACE, DEBUG, INFO, WARN, ERROR)
# Use DEBUG for local dev, INFO for production
CLOUDPOOL_LOG_LEVEL=DEBUG

# ================================================================================
# PRODUCTION DEPLOYMENT NOTES
# ================================================================================

# When deploying to production:
#
# 1. ENCRYPTION KEYS:
#    - Generate CLOUDPOOL_ENCRYPTION_MASTER_KEY and CLOUDPOOL_ENCRYPTION_SALT
#    - Store in a secrets manager (Vault, AWS Secrets Manager, etc.)
#    - Inject at runtime, never commit to version control
#
# 2. DATABASE:
#    - Use PostgreSQL 15+ (not H2)
#    - Create a dedicated database role with minimum required permissions
#    - Enable SSL/TLS for all connections
#    - Set SPRING_DATASOURCE_URL to real PostgreSQL connection string
#
# 3. JWT_SECRET:
#    - Generate a new strong secret value
#    - Rotate periodically (with JWT grace period for in-flight tokens)
#
# 4. SERVICE DISCOVERY:
#    - Replace localhost URLs with internal DNS names or Kubernetes service names
#    - Ensure all services can reach the database and each other
#
# 5. EXTERNAL SERVICES:
#    - Configure real Weaviate, OpenAI, and Google Drive credentials
#    - Use API keys scoped with minimal required permissions
#    - Enable audit logging for API key usage
#
# 6. SECURITY:
#    - Enable HTTPS/TLS for all external APIs
#    - Configure firewall rules to restrict inter-service communication
#    - Set CLOUDPOOL_CORS_ALLOWED_ORIGINS to your actual frontend domain
#    - Disable DEBUG logging in production
#
# 7. MONITORING:
#    - Configure Prometheus/Grafana for metrics collection
#    - Set up alerting for service health and encryption key rotation reminders
#
# For detailed deployment instructions, see: docs/DEPLOYMENT.md
