{
  "name": "@cloudpool/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for the CloudPool developer infrastructure platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": ["cloudpool", "baas", "sdk", "database", "storage", "vector-search"],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "graphql": "^16.0.0",
    "graphql-request": "^6.0.0"
  }
}
